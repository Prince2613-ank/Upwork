# ==========================================================
# Flodata Analytics: Upwork Intelligence Collection Config
# ==========================================================

# Data Source Mode: "mock", "browser", or "api"
DATA_SOURCE_MODE=mock

# Playwright / Chrome CDP Settings (for browser mode)
# When Chrome is launched with --remote-debugging-port=9222:
CHROME_CDP_URL=http://localhost:9222
BROWSER_HEADLESS=false

# Date Window (in days for cutoff calculation; default: 30 days = 1 month)
DATE_WINDOW_DAYS=30

# Request Pacing & Safety (seconds)
MIN_REQUEST_DELAY_SEC=2.0
MAX_REQUEST_DELAY_SEC=4.5
MAX_RETRIES=3
BACKOFF_FACTOR=2.0

# Upwork Official GraphQL API (Optional - when credentials approved)
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_ACCESS_TOKEN=
UPWORK_TENANT_ID=
