# Private server configuration. Run: python -m deploy.configure --from-local --domain YOUR_DOMAIN
DOMAIN=upwork.example.com
PUBLIC_URL=https://upwork.example.com
DASHBOARD_USER=admin
# Set interactively with: python -m server.admin set-password --env-file .env.server
DASHBOARD_PASSWORD_SCRYPT=
SESSION_COOKIE_SECURE=true
SESSION_HOURS=8
# Generated by deploy.configure; hex avoids URL escaping issues.
POSTGRES_PASSWORD=replace-with-random-hex
PIPELINE_TIMEZONE=Asia/Kolkata
# Blank keeps the default search filters.
UPWORK_SEARCH_URL=
GOOGLE_CHAT_WEBHOOK=
GOOGLE_CHAT_SPACE=
GOOGLE_CHAT_TOKEN_FILE=/secrets/google-chat-token.json
FLODATA_IMAGE=flodata-server:local
