# Copy to .env.server. Never commit the real file.
DOMAIN=upwork.example.com
PUBLIC_URL=https://upwork.example.com
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=replace-with-a-long-unique-password
# Generate a bcrypt hash of the SAME password; wrap the hash in single quotes.
DASHBOARD_PASSWORD_HASH='replace-with-caddy-hash'
# Use a random HEX password here so it is safe inside a database URL.
POSTGRES_PASSWORD=replace-with-random-hex
PIPELINE_TIMEZONE=Asia/Kolkata
# Leave blank to preserve the existing 25-location, payment-verified filter.
# Override with your own Upwork search URL if needed; recency/page-size are enforced.
UPWORK_SEARCH_URL=
# Secrets are configured here, never pasted into dashboard logs or committed.
GOOGLE_CHAT_WEBHOOK=
GOOGLE_CHAT_SPACE=spaces/REPLACE_ME
GOOGLE_CHAT_TOKEN_FILE=/secrets/google-chat-token.json
# Optional immutable image tag/digest produced by GitHub Actions.
FLODATA_IMAGE=flodata-server:local
